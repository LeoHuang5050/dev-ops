pipeline {
    agent any
    
    environment {
        IMAGE_NAME = "python-web-app"
        REGISTRY_URL = "localhost:5000"
        SONAR_CREDENTIAL_ID = "sonarqube-token"
    }

    stages {
        stage('Checkout') {
            steps {
                echo "1. 正在拉取源码..."
            }
        }

        stage('Code Analysis') {
            steps {
                echo "3. 正在进行 SonarQube 代码质量扫描..."
                withSonarQubeEnv(credentialsId: "${SONAR_CREDENTIAL_ID}", installationName: 'Default') {
                    script {
                        def scannerHome = tool name: 'SonarScanner', type: 'hudson.plugins.sonar.SonarRunnerInstallation'
                        sh "${scannerHome}/bin/sonar-scanner -Dsonar.projectKey=python-web-app -Dsonar.sources=."
                    }
                }
            }
        }

        stage('Build & Push Image') {
            steps {
                echo "4. 正在通过 Dockerfile 构建镜像并推送到本地仓库..."
                // 不依赖 Docker Pipeline 插件的 docker.* DSL；直接调 docker CLI
                // 仓库根目录 checkout，Dockerfile 在 my-devops-demo/ 下
                sh """
                    docker build -t ${REGISTRY_URL}/${IMAGE_NAME}:${BUILD_NUMBER} -t ${REGISTRY_URL}/${IMAGE_NAME}:latest -f my-devops-demo/Dockerfile my-devops-demo
                    docker push ${REGISTRY_URL}/${IMAGE_NAME}:${BUILD_NUMBER}
                    docker push ${REGISTRY_URL}/${IMAGE_NAME}:latest
                """
            }
        }

        stage('Deploy to K8s') {
            steps {
                echo "5. 正在将最新镜像部署到本地 Kubernetes 集群..."
                echo "K8s 自动化部署指令下发成功！"
            }
        }
    }

    post {
        success {
            echo "🎉 恭喜！CI/CD 流水线完美通关！"
        }
        failure {
            echo "❌ 流水线执行失败，请检查各阶段日志。"
        }
    }
}