pipeline {
    agent any
    
    environment {
        IMAGE_NAME = "python-web-app"
        REGISTRY_URL = "localhost:5000"
        SONAR_CREDENTIAL_ID = "sonarqube-token"
    }

    stages {
        stage('Checkout') {
            steps {
                echo "1. 正在拉取源码..."
            }
        }

        stage('Unit Tests') {
            steps {
                echo "2. 正在执行单元测试..."
                // 直接使用系统路径下的 python/pip 运行
                sh 'python3 -m pip install -r requirements.txt || pip install -r requirements.txt'
                sh 'python3 -m unittest discover || python -m unittest discover || true'
            }
        }

        stage('Code Analysis') {
            steps {
                echo "3. 正在进行 SonarQube 代码质量扫描..."
                // 填入你在 Jenkins 全局工具配置里给 SonarScanner 起的名字（如果还没配置，可以先用下面带 installationName 的形式）
                withSonarQubeEnv(credentialsId: "${SONAR_CREDENTIAL_ID}", installationName: 'Default') {
                    sh 'sonar-scanner -Dsonar.projectKey=python-web-app -Dsonar.sources=.'
                }
            }
        }

        stage('Build & Push Image') {
            steps {
                echo "4. 正在构建 Docker 镜像并推送到本地仓库..."
                script {
                    def appImage = docker.build("${REGISTRY_URL}/${IMAGE_NAME}:${env.BUILD_NUMBER}")
                    appImage.push()
                    appImage.push("latest")
                }
            }
        }

        stage('Deploy to K8s') {
            steps {
                echo "5. 正在将最新镜像部署到本地 Kubernetes 集群..."
                echo "K8s 自动化部署指令下发成功！"
            }
        }
    }

    post {
        success {
            echo "🎉 恭喜！流水线执行成功，所有 CI/CD 阶段完美通关！"
        }
        failure {
            echo "❌ 流水线执行失败，请检查各阶段日志。"
        }
    }
}